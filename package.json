{
  "name": "harbordesk-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo: adding AI triage, RAG reply drafts and natural-language analytics to an existing SaaS support console.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "eval": "node eval/run.js",
    "test": "node --test server/ai/guardrails.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
