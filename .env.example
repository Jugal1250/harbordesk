# AI provider: "groq" (free key at console.groq.com/keys) or "mock" (offline, rule-based, for tests)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Models per feature. If one is retired, check console.groq.com/docs/models.
# The smaller model handles triage, which runs on every incoming ticket and has the highest
# volume; the larger one handles reply drafting and SQL, where quality matters more than cost.
TRIAGE_MODEL=openai/gpt-oss-20b
REPLY_MODEL=openai/gpt-oss-120b
SQL_MODEL=openai/gpt-oss-120b

# Tickets the model is less sure about than this go to a human instead of auto-routing.
CONFIDENCE_THRESHOLD=0.7

# Set to 1 to log every policy tripwire match during triage. Off by default so `npm run eval`
# stays readable.
AI_DEBUG=

# Optional: n8n webhook that receives ticket events (urgent alerts, daily digest).
N8N_WEBHOOK_URL=

PORT=8787
